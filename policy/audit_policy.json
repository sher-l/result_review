{
  "framework_version": "v7.1",
  "updated_at": "2026-08-04",
  "mode": "formal_audit",
  "canonical_entrypoints": [
    "README.md",
    "MASTER_PROMPT.md",
    "CORE_RULES.md",
    "policy/audit_policy.json",
    "AI_INDEX.md"
  ],
  "reference_only_docs": [
    "WORKFLOW.md",
    "CONVERGENCE_REVIEW_PROTOCOL.md",
    "CHECKLIST_TEMPLATE.md",
    "WORKFLOW_MODULE_CHECKS.md",
    "STATISTICS_REFERENCE.md",
    "report_templates/project_config_template.json",
    "lessons/",
    "archive/"
  ],
  "intent_triggers_formal_audit": [
    "开始审核",
    "审核下一个",
    "重审",
    "复审"
  ],
  "default_execution": {
    "auto_start_three_subagents": true,
    "must_complete_visual_audit": true,
    "must_disposition_mechanical_checks": true,
    "must_use_structured_evidence_fields": true,
    "must_generate_case_manifest": true,
    "must_write_review_event_log": true,
    "must_run_convergence_compare": true,
    "must_generate_arbitration_queue": true,
    "must_run_final_report_linter": true,
    "must_lint_markdown_structure": true,
    "must_validate_markdown_links": true,
    "must_generate_lint_autofix_plan": true,
    "must_apply_lint_autofix_plan_when_available": true,
    "must_sync_audit_state": true,
    "must_export_html_after_markdown": true,
    "must_finalize_via_finalize_audit": true,
    "must_auto_archive_after_finalize": true,
    "must_archive_only_after_publish_success": true,
    "must_reject_no_auto_archive": true,
    "must_read_lesson_bank_before_audit": true,
    "must_update_lesson_bank_after_audit": true,
    "must_prioritize_lesson_bank_matches": true,
    "must_use_small_slice_subagents": true,
    "must_persist_slice_agent_outputs": true,
    "must_checkpoint_between_slice_batches": true,
    "must_not_launch_monolithic_subagents": true,
    "must_record_subagent_supervision_summary": true,
    "must_gate_finalize_on_subagent_supervision": true,
    "must_prepare_before_sealed_finalize": true,
    "must_write_final_decision_contract": true,
    "must_validate_audit_contract_before_publish": true,
    "must_write_visual_audit_result": true,
    "must_prevent_duplicate_completion_notification": true,
    "must_bind_formal_delivery_artifacts": true
  },
  "audit_contract_policy": {
    "schema_version": "1.0",
    "mode": "enforce",
    "decision_json": "final_decision.json",
    "validation_json": "audit_contract_validation.json",
    "manifest_schema_version": "1.1",
    "audit_contract_version": "1.0",
    "allowed_verdict_release_pairs": {
      "合格": "ALLOW",
      "有条件合格": "CONDITIONAL",
      "不合格": "BLOCK"
    },
    "required_severity_levels": [
      "FATAL",
      "CRITICAL",
      "MAJOR",
      "WARNING",
      "INFO"
    ],
    "formal_completion_requires_unresolved_count": 0,
    "source_paths_must_be_review_relative": true,
    "source_hash_algorithm": "sha256",
    "finalize_must_not_modify_confirmed_sources": true,
    "formal_finalize_cli_mode_override_allowed": false,
    "shadow_exit_code_on_would_block": 0,
    "enforce_exit_code_on_block": 1
  },
  "notification_idempotency_policy": {
    "mode": "enforce",
    "receipt_json": "completion_notification_receipt.json",
    "states": [
      "pending",
      "sent",
      "failed",
      "unknown"
    ],
    "idempotency_components": [
      "decision_sha256",
      "body_sha256",
      "channel"
    ],
    "skip_send_when_matching_receipt_is_sent": true,
    "block_automatic_resend_when_status_unknown": true,
    "block_when_receipt_decision_hash_differs": true,
    "archive_requires_sent_receipt": true,
    "pre_notification_gate_failures_are_local_only": true,
    "test_network_policy": "deny_all_outbound_notifications"
  },
  "visual_closure_policy": {
    "mode": "enforce",
    "result_json": "visual_audit_result.json",
    "inventory_scope": [
      "report_embedded_assets",
      "project_delivery_figures"
    ],
    "recognized_unsupported_formats": [
      ".emf",
      ".wmf"
    ],
    "required_count_invariant": "asset_total=reviewed+skipped+unsupported",
    "require_unaccounted_zero": true,
    "require_reason_for_skipped_or_unsupported": true,
    "high_risk_unsupported_requires_derivative_or_alternative_evidence": true,
    "machine_flag_zero_is_not_human_completion": true
  },
  "professional_contract_policy": {
    "arbitration_schema_version": "2.0",
    "arbitration_mode": "enforce",
    "validation_json": "professional_contract_validation.json",
    "checker_modes": {
      "dataset_scope": "shadow",
      "statistical_flow": "shadow",
      "method_code": "shadow",
      "ml_lineage": "shadow"
    },
    "structured_artifacts": {
      "dataset_scope": "dataset_scope_matrix.json",
      "statistical_flow": "statistical_flow_graph.json",
      "method_code": "method_code_matrix.json",
      "ml_lineage": "ml_lineage.json"
    },
    "semantic_merge_tuple": [
      "module",
      "claim",
      "error_mechanism",
      "evidence_object",
      "repair_path"
    ],
    "merge_linkage": "complete_link",
    "duplicate_formal_finding_gate": {
      "mode": "enforce",
      "rule": "两条正式发现只要共享同一证据定位，或 error_mechanism 与 repair_path 同时相同（即使定位不同），就必须在正式编号前逐对裁定并归并为一个 canonical finding；如确为独立问题，须在 independence_decisions 中列出实际不同的 module/claim/evidence_object，并分别引用两条 canonical finding 的独立证据。未归并且无充分独立性证据的候选项使仲裁合同校验失败。"
    },
    "final_report_binding_gate": {
      "mode": "enforce",
      "rule": "leader_confirmed 后，final_review_report.md 中每个 F-ID 必须经 finding_key 交叉表唯一绑定到 retained canonical finding；reject/revoked 原始发现不得进入正式问题链，严重度、定位/证据和整改要求必须完整。"
    },
    "protected_merge_vetoes": [
      "dataset_identity",
      "qc_count_invariant",
      "cell_identity_translation",
      "validation_leakage",
      "method_implementation_mismatch",
      "high_risk_provenance",
      "figure_identity"
    ],
    "automated_professional_checks_emit_candidates_only": true
  },
  "lesson_bank_policy": {
    "canonical_dir": "lessons/",
    "read_before_audit": [
      "LESSONS_LEARNED.md",
      "patterns/"
    ],
    "update_targets": [
      "LESSONS_LEARNED.md",
      "LESSONS_LEARNED_<项目编号>.md",
      "patterns/*.md"
    ],
    "required_entry_fields": [
      "错误类型",
      "具体表现",
      "触发场景",
      "证据依据",
      "正确标准",
      "下次审核提醒",
      "严重程度",
      "规则建议"
    ],
    "pre_audit_rule": "审核前必须读取 lessons/ 错题集索引和相关模式，把命中的相似内容列为重点复核项。",
    "post_audit_rule": "审核结束后必须把本次典型错误点、触发场景、证据依据、正确标准、下次审核提醒和可执行规则建议沉淀到错题集；若规则建议明确且证据充分，应同步更新对应 patterns/*.md、索引或政策文档，不能只留待办。",
    "reuse_rule": "后续审核其他项目时，遇到与错题集相同或相近的内容必须重点复核，但必须结合当前项目证据独立判断，不能机械套用历史结论。",
    "rule_suggestion_policy": {
      "must_capture_rule_recommendation": true,
      "apply_when_actionable": true,
      "actionable_definition": "规则建议能归入既有 pattern 或形成明确触发条件，且不会扩大到无证据场景。",
      "update_targets": [
        "lessons/LESSONS_LEARNED.md",
        "lessons/patterns/*.md",
        "policy/audit_policy.json",
        "generated docs"
      ],
      "do_not_apply_when": "仅为个案备注、证据不足或会改变正式审核硬门禁时，先写入项目级 lessons 并标注待复核。"
    },
    "required_project_artifacts": [
      "wrong_question_set.md",
      "framework_optimization_notes.md"
    ],
    "completion_gate_rule": "正式审核完成、finalize、归档或正式通知前，项目审核目录必须存在 wrong_question_set.md 和 framework_optimization_notes.md；缺任一文件时 final_report_linter/完成门禁必须失败，主 agent 不得宣称 completed。",
    "framework_optimization_rule": "审核后必须明确记录框架/agent/策略应如何加固；若无可执行改动，也必须在 framework_optimization_notes.md 写明不改的证据和理由，不能省略该文件。"
  },
  "required_precheck_files": [
    "report_text.txt",
    "report_structure.json",
    "project_structure.json",
    "mechanical_check_result.json",
    "case_manifest.json"
  ],
  "required_final_files": [
    "case_manifest.json",
    "review_event_log.jsonl",
    "coverage_matrix.md",
    "fact_check_list.md",
    "unresolved_items.md",
    "convergence_report.json",
    "convergence_report.md",
    "arbitration_queue.json",
    "final_review_report.md",
    "subagent_supervision_summary.json",
    "subagent_supervision_gate.json",
    "wrong_question_set.md",
    "framework_optimization_notes.md",
    "final_report_lint.json",
    "audit_state.json"
  ],
  "required_final_sections": {
    "audit_conclusion": [
      "审核结论"
    ],
    "blocking_issues": [
      "提交阻断问题"
    ],
    "analysis_table": [
      "逐分析点审核结果"
    ]
  },
  "final_report_display_policy": {
    "analysis_navigation": {
      "section_marker": "逐分析点审核结果",
      "visible_in_reader_html": false,
      "purpose": "保留为结构化审核覆盖底稿；HTML 读者视图不再单独展示，避免与正式问题导航重复。"
    },
    "adjudication_reason_index": {
      "section_marker": "裁定标准与核定理由索引",
      "before_section_marker": "提交阻断问题",
      "expanded_by_default": true,
      "purpose": "作为正式问题导航展示审核结果、错误点与核定理由；默认展开，样式与模块文件计数一致。"
    }
  },
  "final_report_depth_policy": {
    "enabled": true,
    "core_section_marker": "提交阻断问题",
    "secondary_section_marker": "其他已裁定问题",
    "max_core_issues": 5,
    "minimum_core_issues_for_reject": 1,
    "secondary_issue_heading_prefix": "S-",
    "secondary_section_required": false,
    "secondary_issue_requires_detail_when_present": true,
    "required_issue_labels": [
      "错误点",
      "原报告位置",
      "原文短句",
      "交付证据",
      "修订要求"
    ],
    "child_error_heading_prefix": "具体错误",
    "require_child_errors": true,
    "require_indexed_finding_detail_coverage": true,
    "child_required_labels": [
      "错误点",
      "原报告位置",
      "原文短句",
      "交付证据",
      "修订要求"
    ],
    "reader_forbidden_internal_locator_pattern": "report_text.txt:Lxx",
    "impact_max_sentences": 0,
    "rule": "最终报告先呈现不超过 5 个真正改变提交、关键结论或独立复现能力的核心问题；该上限只限制顶层问题主题，不限制其下独立、可执行的错误。一个顶层问题下凡存在两个以上不同的错误机制、原报告位置或修订动作，必须拆为“具体错误 1、2……”，不得为了凑 5 项而合并。每个具体错误都必须写清实际做了什么、具体错在哪里、原报告 DOCX 的可搜索位置、原文短句、交付证据及修订要求；不得用泛泛的影响描述替代错误机制。正式报告禁止把 report_text.txt 行号作为读者证据：该行号只留在审核底稿。页码仅在固定渲染版本已核验时作为辅助，默认以“原 DOCX 文件名 + 章节/图表标题 + 原文短句”定位。其余已裁定问题以 S- 编号列示，也按同一子错误规则展开。收敛投票、机械检查、文件盘点、仲裁过程和未成立候选项属于审核底稿，不进入正式报告。"
  },
  "final_report_presentation_policy": {
    "forbidden_heading_terms": [
      "问题证据展开",
      "分析点与问题清单一致性检查",
      "三路独立审核",
      "交叉收敛",
      "审核分工",
      "收敛投票",
      "评分矩阵",
      "机械检查处置",
      "高风险模块复核",
      "交付文件与代码盘点",
      "正式裁定详情"
    ],
    "rule": "正式报告只呈现读者需要据以修订或判断提交结论的内容。过程性核验、仲裁、盘点和监督信息必须留在审核底稿，不得以章节或 HTML 自动卡片形式进入正式报告。"
  },
  "reader_html_presentation_policy": {
    "mode": "enforce",
    "profile": "reader-v3",
    "baseline_id": "framework-concrete-error-cards-and-reader-projection-20260805",
    "template": "report_templates/final_review_report_template.html",
    "template_sha256_lf": "2190850fe4cff64c16dfd40e9f30acd391f87105fe7cfb04bd774942e20e8734",
    "stylesheet_sha256_lf": "9ba9edea2c5adf01da4fc4886d707302ba98356d09d5b2052e54070e4aa8f325",
    "script_sha256_lf": "9f54e1bf32825828406be42339eeaf4afc2e1dfc1527d83c4b4f9467b740dbd1",
    "hash_normalization": "UTF-8 text with LF newlines",
    "required_inventory_legend": "标灰说明：灰色行表示该模块/目录仅交付数据表/数据文件，或仅交付图件/PDF；标灰仅提示交付类型单一，不代表问题严重度。",
    "hidden_internal_heading_terms": [
      "finding_key → F-ID 交叉表",
      "仲裁原始发现交叉索引",
      "F-ID 绑定索引"
    ],
    "upgrade_rule": "任何读者视觉资产或固定页面骨架变更必须升级 presentation profile；不得仅刷新当前 profile 指纹。"
  },
  "audit_dimensions": [
    {
      "id": "D1",
      "name": "覆盖完整性",
      "question": "是否漏掉模块、数据集、分组、阴性结果或失败分析"
    },
    {
      "id": "D2",
      "name": "事实正确性",
      "question": "数据库、URL、术语、翻译、数字和方向是否正确"
    },
    {
      "id": "D3",
      "name": "三方一致性",
      "question": "正文、表格、图注、结果文件是否一致"
    },
    {
      "id": "D4",
      "name": "结果可追溯",
      "question": "关键结论能否追溯到具体文件与位置"
    },
    {
      "id": "D5",
      "name": "证据充分性",
      "question": "是否有结构化结果和原始数值支持，而不只是图片"
    },
    {
      "id": "D6",
      "name": "方法-代码一致",
      "question": "方法、参数、阈值、包名与代码实现是否一致"
    }
  ],
  "finding_evidence_policy": {
    "required_fields": [
      "finding_key",
      "id",
      "severity",
      "dimension",
      "location",
      "description",
      "evidence",
      "rule",
      "source_type",
      "source_path",
      "locator",
      "quote_or_value"
    ],
    "allowed_source_types": [
      "report_text",
      "figure",
      "table",
      "result_file",
      "code",
      "precheck"
    ],
    "semantic_convergence_fields": [
      "raw_finding_id",
      "cluster_key",
      "module",
      "claim",
      "error_mechanism",
      "evidence_object",
      "repair_path"
    ],
    "semantic_fields_mode": "shadow"
  },
  "review_lane_policy": {
    "default_lane": "strict",
    "allowed_lanes": [
      "standard",
      "strict"
    ],
    "strict_mode_rule": "all_non_decoration_figures_require_ai_review",
    "standard_mode_rule": "ai_review_only_for_high_risk_or_machine_flagged_figures"
  },
  "figure_delivery_policy": {
    "preferred_primary_format": "pdf",
    "pdf_only_allowed": true,
    "warn_png_only_without_pdf": true,
    "do_not_warn_pdf_without_png": true,
    "alternative_render_sources": [
      ".pdf",
      ".pptx",
      ".svg"
    ],
    "format_rule": "结果图件可以仅交付可渲染 PDF；不再因缺少 PNG 单独记问题。仅有 PNG/JPG 等位图且无 PDF 时记录 WARNING 或说明例外。文件不可渲染、损坏、错图或影响复核时仍按内容问题升级。若同一图件同时存在可读的 PDF、PPTX 或 SVG，单个派生 PNG 异常不得被表述为“图件/流程图不可读”；只有交付规范明确要求该派生格式时，才可单列为格式兼容性问题。"
  },
  "publish_archive_policy": {
    "canonical_html_pattern": "<project_id>_audit_report.html",
    "archive_target_dir": "raw/已AI审核一次",
    "auto_archive_after_finalize": true,
    "disable_no_auto_archive": true,
    "finalize_fails_if_archive_missing": true,
    "publish_status_values": [
      "pending",
      "success",
      "failed"
    ],
    "archive_requires": [
      "publish_status=success",
      "archive_approved=true",
      "framework_health=passed",
      "policy_binding=matched",
      "leader_confirmed_contract=valid",
      "professional_contracts=valid",
      "visual_closure=passed",
      "post_audit_learning_artifacts=present",
      "formal_delivery_manifest=current",
      "completion_notification_receipt=sent_and_current"
    ]
  },
  "high_risk_module_policy": {
    "target_modules": [
      "molecular_docking",
      "molecular_dynamics",
      "virtual_knockout",
      "graphban_virtual_screening"
    ],
    "required_dimensions": [
      "module_exists",
      "evidence_sufficient",
      "reproducible",
      "conclusion_not_overstated"
    ],
    "minimum_evidence_packages": {
      "molecular_docking": [
        "target_protein_or_receptor",
        "ligand_list",
        "score_table",
        "pose_or_interaction_figure",
        "threshold_or_interpretation_rule"
      ],
      "molecular_dynamics": [
