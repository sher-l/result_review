      "一个子代理同时承担图文、代码、统计、高风险模块全量审核",
      "Sub-Agent 在聊天中回传完整 Markdown 报告、完整 JSON、长日志或大表",
      "Lead 在最终回复中粘贴完整通知 metadata、归档路径、监督 JSON 路径或内部字段",
      "为了说明完成状态而把所有产物路径和详细摘要塞进主线程"
    ],
    "merge_contract": "slice JSONs are merged into agent_a_result.json, agent_b_result.json, and agent_c_result.json before convergence_compare.py",
    "model_quality_policy": {
      "principle": "切小片只为控制上下文，不允许降低正式审核判断能力；正式审核子代理必须使用与主 agent 相同的模型",
      "formal_judgement_slices_require": "same_model_as_lead_agent_required",
      "current_frontier_example": "示例仅为运行环境主 agent 模型；正式审核以主 agent 当前模型为准，不写死降级模型",
      "fast_model_allowed_only_for": [
        "file_mapping",
        "path_inventory",
        "format_or_schema_check",
        "grep_like_lookup"
      ],
      "must_not_downshift_for": [
        "severity_judgement",
        "cross_module_consistency",
        "statistical_validity",
        "high_risk_module_assessment",
        "final_arbitration"
      ],
      "must_preserve_overlap_context": [
        "report_summary",
        "conclusion_sections",
        "figure_table_index",
        "mechanical_check_summary",
        "case_manifest",
        "slice_neighbor_dependencies"
      ],
      "high_risk_slice_rule": "高风险模块切片必须保留模块级完整上下文；不能按单文件过窄拆分",
      "lead_global_review_required": true,
      "must_inherit_lead_model": true,
      "must_not_override_to_lower_model": true,
      "same_reasoning_effort_rule": "reasoning effort must match Lead when known; if Lead is high, judgement subagents must be high"
    },
    "overlap_and_global_review": {
      "minimum_overlap": "关键摘要/结论/图表索引/机械检查摘要至少进入所有判断型切片",
      "cross_slice_checks": [
        "coverage_gap",
        "conflicting_findings",
        "module_dependency_break",
        "local_pass_global_fail",
        "unassigned_high_risk_module"
      ],
      "route_merge_limit": "A/B/C 汇总器只能汇总 slice JSON；全局一致性与最终裁决由 Lead 执行"
    },
    "if_subagent_compact_or_context_loss": {
      "required_action": "split_scope_again_before_retry",
      "must_not_retry_same_scope": true,
      "split_axes": [
        "report_section",
        "analysis_module",
        "figure_range",
        "file_group",
        "evidence_type",
        "issue_cluster"
      ],
      "maximum_retry_scope": "one narrow slice with one explicit output artifact",
      "leader_contract": "Lead records failed slice path/blocker, creates smaller child slices, and retries only those slices; do not pull failed slice context into Lead chat."
    },
    "subagent_chat_return_budget": {
      "max_lines": 5,
      "allowed_fields": [
        "status",
        "output_path",
        "finding_counts",
        "highest_severity",
        "blockers"
      ],
      "must_not_include": [
        "full_markdown_report",
        "full_json",
        "long_logs",
        "large_tables",
        "full_notification_metadata",
        "archived_internal_paths"
      ],
      "overflow_rule": "anything longer must be written to the declared artifact path and referenced by path only"
    },
    "leader_final_reply_budget": {
      "max_lines": 8,
      "formal_audit_notification_body": "compact_allowlist_only",
      "allowed_fields": [
        "status",
        "time",
        "project",
        "report_file",
        "audit_result",
        "issue_stats"
      ],
      "must_not_include": [
