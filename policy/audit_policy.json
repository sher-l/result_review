  "deprecated_behavior": [
    "把三路 sub-agent 当成可选动作",
    "直接照抄 mechanical_check_result.json",
    "只给总评不给逐分析点结论",
    "把模块存在、证据充分、可复现、结论强度混为一个判断"
  ],
  "rereview_policy": {
    "mode": "targeted",
    "must_build_rereview_diff": true,
    "max_rounds_before_keep_blocking_verdict": 2
  },
  "subagent_compact_policy": {
    "execution_model": "small_slice_subagents_then_three_route_merge",
    "leader_role": "supervisor_and_integrator_only",
    "max_parallel_slice_agents": 4,
    "default_slice_result_dir": "agent_results/slices",
    "default_slice_prompt_dir": "agent_prompts/slices",
    "must_not_fork_full_context": true,
    "must_persist_slice_results": true,
    "must_checkpoint_between_batches": true,
    "chat_output_contract": "max_5_lines_status_path_counts_blockers_only",
    "leader_context_rule": "Lead 不直接展开长报告、长日志、完整清单、完整 JSON、完整通知元数据或大证据；正式审核证据由 subagent 落盘，Lead 只读取短状态、证据路径、计数和最终必要片段。",
    "forbidden_patterns": [
      "单个 Sub-Agent 完整审核整个项目",
      "同时启动 3 个大而全 Sub-Agent 完整审核整个项目",
      "每个 Sub-Agent 是全栈审核员",
      "把完整 report_text.txt 粘贴进所有子代理 prompt",
