        "replacement": "AI核查",
        "severity": "error"
      },
      {
        "term": "人工抽查",
        "replacement": "AI抽查",
        "severity": "error"
      },
      {
        "term": "人工审核",
        "replacement": "AI审核",
        "severity": "error"
      },
      {
        "term": "人工审查",
        "replacement": "AI审查",
        "severity": "error"
