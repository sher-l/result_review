        "downstream_filtering_lineage"
      ]
    }
  },
  "mechanical_check_policy": {
    "all_codes_must_have_disposition": true,
    "special_rules": {
      "MC-005": "目录命名未匹配仅作候选问题，必须经 AI 复核后才能认定模块缺失。",
      "MC-011": "硬编码路径默认只作背景信息；只有暴露错误项目来源、错误模块来源或结果来源不明时才升级。",
      "MC-016": "参考文献后的公司宣传页/服务领域页默认视为 boilerplate，不纳入高风险模块判定；只有这些内容出现在参考文献前的正式正文中，才升级为实质问题。"
    }
  },
  "report_appendix_policy": {
    "ignore_company_promo_after_references": true,
    "reference_markers": [
      "参考文献",
      "References"
    ],
    "boilerplate_markers": [
      "公司介绍",
      "服务领域",
      "联系我们"
    ],
    "default_handling": "treat_as_out_of_scope_boilerplate",
    "escalation_rule": "Only flag company promo content when it appears before the references section or contaminates numbered body sections."
  },
  "forbidden_shortcuts": [
    "整体基本一致",
    "未见明显问题",
    "模块已检查",
    "大体支持结论"
  ],
  "lint_policy": {
    "check_external_links": true,
    "check_local_links": true,
    "external_link_cache_ttl_days": 7,
    "ignore_external_url_patterns": [],
    "ignored_warning_prefixes": [],
    "warning_prefixes_as_errors": [],
    "placeholder_terms": [
      "TODO",
      "TBD",
      "FIXME",
      "待补",
      "待补充",
      "占位",
      "xxx",
      "XXX"
    ]
  },
  "formal_delivery_policy": {
    "enabled": true,
