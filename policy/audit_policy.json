        "task_name",
        "summary",
        "workspace",
        "review_dir",
        "html_report",
        "archived_to",
        "subagent_supervision_summary",
        "subagent_supervision_gate",
        "full_metadata"
      ],
      "overflow_rule": "do not paste full metadata or artifact content into chat; cite paths only when user asks"
    }
  },
  "subagent_supervision_policy": {
    "enabled": true,
    "required_for_finalize": true,
